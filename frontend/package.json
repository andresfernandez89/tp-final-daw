    "@angular/router": "~21.2.25",
    "@primeuix/themes": "~2.0.3",
    "primeng": "~21.1.10",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "~21.2.28",
    "@angular/cli": "~21.2.28",
    "@angular/compiler-cli": "~21.2.25",
